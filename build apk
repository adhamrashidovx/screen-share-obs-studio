name: Build 64-Bit OBS TCP Streamer APK

on:
  push:
    branches: [ "*" ]
  workflow_dispatch:

jobs:
  build-64bit-apk:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Auto-extract ZIP if uploaded directly from mobile phone
        run: |
          if [ ! -f "settings.gradle.kts" ]; then
            ZIP_FILE=$(find . -maxdepth 2 -name "*.zip" | head -n 1)
            if [ -n "$ZIP_FILE" ]; then
              echo "Found uploaded ZIP archive: $ZIP_FILE. Extracting automatically..."
              unzip -o "$ZIP_FILE" -d .
            fi
          fi
          ls -la

      - name: Set up JDK 17 (64-bit)
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Accept Android SDK Licenses
        run: |
          yes | $ANDROID_HOME/cmdline-tools/latest/bin/sdkmanager --licenses || true

      - name: Setup Gradle 8.6
        uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: '8.6'

      - name: Build 64-bit Release & Debug APK
        run: gradle assembleRelease assembleDebug --no-daemon --stacktrace

      - name: Upload Ready-to-Install 64-bit APK
        uses: actions/upload-artifact@v4
        with:
          name: OBS-TCP-Screen-Streamer-64bit-APK
          path: |
            app/build/outputs/apk/release/*.apk
            app/build/outputs/apk/debug/*.apk
